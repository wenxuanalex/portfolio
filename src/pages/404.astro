---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, projects } from "../data/site";

const suggestions = projects.slice(0, 3);
---

<BaseLayout
  title={`Page not found — ${profile.name}`}
  description="That page doesn't exist."
>
  <header class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-canvas/70">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a
        href="/"
        class="text-sm font-semibold tracking-tight text-ink hover:text-accent-soft transition-colors"
      >
        {profile.name}
      </a>
      <a
        href={profile.resumeUrl}
        class="inline-flex items-center text-sm font-medium text-ink border border-border rounded-full px-4 py-1.5 hover:border-accent hover:text-accent-soft transition-colors"
      >
        Résumé
      </a>
    </div>
  </header>

  <main
    class="relative min-h-screen flex items-center justify-center overflow-hidden"
  >
    <div class="glow absolute inset-0 pointer-events-none"></div>

    <div class="relative max-w-xl mx-auto px-6 py-24 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent-soft">
        Error 404
      </p>
      <h1
        class="mt-6 text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-[1.15] text-balance"
      >
        That page doesn't exist
      </h1>
      <p class="mt-4 text-base text-ink-subtle leading-relaxed">
        The link may be out of date, or the address mistyped. Everything worth
        reading is one step away.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center rounded-full bg-accent text-white font-semibold text-sm px-6 py-3 hover:bg-accent-hover transition-colors"
        >
          Go home
        </a>
        <a
          href="/#work"
          class="inline-flex items-center rounded-full border border-border text-ink font-semibold text-sm px-6 py-3 hover:border-accent hover:text-accent-soft transition-colors"
        >
          See the work
        </a>
      </div>

      <div class="mt-14 pt-8 border-t border-border text-left">
        <p
          class="font-mono text-xs uppercase tracking-[0.15em] text-accent-soft"
        >
          Recent case studies
        </p>
        <ul class="mt-4 space-y-3 list-none m-0 p-0">
          {
            suggestions.map((project) => (
              <li>
                <a
                  href={`/work/${project.slug}`}
                  class="group inline-flex items-center gap-2 text-sm text-ink-subtle hover:text-ink transition-colors"
                >
                  {project.title}
                  <span
                    aria-hidden="true"
                    class="arrow-nudge text-accent-soft transition-transform group-hover:translate-x-1"
                  >
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
</BaseLayout>
