---
import Section from "./Section.astro";
import { experience, education } from "../data/site";
---

<Section id="experience" title="Where I've worked">
  <div class="relative">
    <div
      class="absolute left-0 md:left-40 top-2 bottom-2 w-px bg-border hidden md:block"
    >
    </div>
    <div class="space-y-10">
      {
        experience.map((job) => (
          <div class="md:flex md:gap-8 relative">
            <div class="font-mono text-sm text-accent-soft md:w-40 shrink-0 md:text-right md:pr-8 mb-2 md:mb-0">
              {job.period}
            </div>
            <div class="md:pl-8 relative">
              <span class="hidden md:block absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-accent" />
              <h3 class="text-ink font-semibold">
                {job.role} · <span class="text-ink-subtle">{job.company}</span>
              </h3>
              <p class="text-ink-subtle text-sm mt-2 leading-relaxed max-w-xl">
                {job.detail}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <h3
    class="mt-16 font-mono text-xs uppercase tracking-[0.15em] text-accent-soft pb-3 border-b border-border"
  >
    Education
  </h3>
  <div class="mt-6 space-y-4">
    {
      education.map((edu) => (
        <div class="rounded-lg border border-border bg-canvas-raised p-6 md:flex md:items-start md:gap-6">
          <div class="font-mono text-sm font-medium text-accent-soft md:w-40 shrink-0 mb-2 md:mb-0">
            {edu.period}
          </div>
          <div>
            <h4 class="text-ink font-semibold">{edu.degree}</h4>
            <p class="text-ink-subtle text-sm mt-0.5">{edu.school}</p>
            <p class="text-ink-subtle text-sm mt-3 leading-relaxed">
              {edu.detail}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
