---
import Section from "./Section.astro";
import { experience } from "../data/site";
---

<Section id="experience" eyebrow="Where I've worked" title="Experience">
  <div class="relative">
    <div
      class="absolute left-0 sm:left-40 top-2 bottom-2 w-px bg-border hidden sm:block"
    >
    </div>
    <div class="space-y-10">
      {
        experience.map((job) => (
          <div class="sm:flex sm:gap-8 relative">
            <div class="font-mono text-sm text-accent-soft sm:w-40 shrink-0 sm:text-right sm:pr-8 mb-2 sm:mb-0">
              {job.period}
            </div>
            <div class="sm:pl-8 relative">
              <span class="hidden sm:block absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-accent" />
              <h3 class="text-ink font-semibold">
                {job.role} · <span class="text-ink-subtle">{job.company}</span>
              </h3>
              <p class="text-ink-faint text-sm mt-2 leading-relaxed max-w-xl">
                {job.detail}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>
