---
import { profile, navItems } from "../data/site";
---

<header class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-canvas/70">
  <div
    class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between"
  >
    <a
      href="#hero"
      class="text-sm font-semibold tracking-tight text-ink hover:text-accent-soft transition-colors"
    >
      {profile.name}
    </a>

    <nav aria-label="Primary">
      <ul class="hidden sm:flex gap-7 list-none m-0 p-0">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link text-sm text-ink-subtle hover:text-ink transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={profile.resumeUrl}
      class="hidden sm:inline-flex text-sm font-medium text-ink border border-border rounded-full px-4 py-1.5 hover:border-accent hover:text-accent-soft transition-colors"
    >
      Résumé
    </a>
  </div>
</header>
