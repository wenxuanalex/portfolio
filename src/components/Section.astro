---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}
const { id, title, eyebrow } = Astro.props;
---

<section id={id} class="max-w-5xl mx-auto px-6 py-20 sm:py-28 scroll-mt-20">
  <div class="mb-12">
    {
      eyebrow && (
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent-soft mb-3">
          {eyebrow}
        </p>
      )
    }
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      {title}
    </h2>
  </div>
  <slot />
</section>
