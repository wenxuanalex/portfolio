---
import Section from "./Section.astro";
import { projects } from "../data/site";

const featured = projects.find((project) => project.featured);
const rest = projects.filter((project) => !project.featured);

// Cards carry a thumbnail whenever real artwork exists. The grid lets each
// card size to its own content (items-start), so a text-only card is simply
// shorter rather than showing a void beside an illustrated neighbour.
---

<Section id="work" title="Built end to end, not just modelled">
  {
    featured && (
      <a
        href={`/work/${featured.slug}`}
        class="group block rounded-lg border border-border bg-canvas-raised p-6 sm:p-8 hover:border-accent transition-colors"
      >
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent-soft">
          Featured
        </p>
        <h3 class="mt-4 text-xl sm:text-2xl font-bold tracking-tight text-ink group-hover:text-accent-soft transition-colors">
          {featured.title}
        </h3>
        <p class="mt-3 text-sm text-ink-subtle leading-relaxed max-w-2xl">
          {featured.blurb}
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          {featured.tags.map((tag) => (
            <span class="font-mono text-xs text-ink-subtle border border-border rounded-full px-2.5 py-1">
              {tag}
            </span>
          ))}
        </div>
        <span class="mt-6 text-sm font-medium text-accent-soft inline-flex items-center gap-1">
          Read the case study
          <span
            aria-hidden="true"
            class="arrow-nudge transition-transform group-hover:translate-x-1"
          >
            →
          </span>
        </span>
      </a>
    )
  }

  <div class="mt-6 grid gap-6 sm:grid-cols-2 items-start">
    {
      rest.map((project) => (
        <a
          href={`/work/${project.slug}`}
          class="group rounded-lg border border-border bg-canvas-raised p-6 flex flex-col hover:border-accent transition-colors"
        >
          {project.hero && (
            <img
              src={project.hero.src}
              alt=""
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
              class="mb-5 w-full rounded-md border border-border"
            />
          )}
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent-soft transition-colors">
            {project.title}
          </h3>
          <p class="mt-3 text-sm text-ink-subtle leading-relaxed flex-1">
            {project.blurb}
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.tags.slice(0, 4).map((tag) => (
              <span class="font-mono text-xs text-ink-subtle border border-border rounded-full px-2.5 py-1">
                {tag}
              </span>
            ))}
          </div>
          <span class="mt-5 text-sm font-medium text-accent-soft inline-flex items-center gap-1">
            Read the case study
            <span
              aria-hidden="true"
              class="arrow-nudge transition-transform group-hover:translate-x-1"
            >
              →
            </span>
          </span>
        </a>
      ))
    }
  </div>
</Section>
