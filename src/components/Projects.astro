---
import Section from "./Section.astro";
import { projects } from "../data/site";
---

<Section id="projects" eyebrow="Selected work" title="Projects">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-lg border border-border bg-canvas-raised p-6 flex flex-col hover:border-accent transition-colors"
        >
          <h3 class="text-lg font-semibold text-ink group-hover:text-accent-soft transition-colors">
            {project.title}
          </h3>
          <p class="mt-3 text-sm text-ink-subtle leading-relaxed flex-1">
            {project.blurb}
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="font-mono text-xs text-ink-subtle border border-border rounded-full px-2.5 py-1">
                {tag}
              </span>
            ))}
          </div>
          <span class="mt-5 text-sm font-medium text-accent-soft inline-flex items-center gap-1">
            View Project
            <span
              aria-hidden="true"
              class="arrow-nudge transition-transform group-hover:translate-x-1"
            >
              →
            </span>
          </span>
        </a>
      ))
    }
  </div>
</Section>
