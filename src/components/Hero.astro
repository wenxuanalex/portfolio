---
import { profile } from "../data/site";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="glow absolute inset-0 pointer-events-none"></div>

  <div class="relative max-w-3xl mx-auto px-6 text-center">
    <p
      class="font-mono text-xs uppercase tracking-[0.25em] text-accent-soft mb-6"
    >
      {profile.name}
    </p>
    <h1
      class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-[1.12] text-balance"
    >
      {profile.headline}
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-ink-muted font-medium">
      {profile.role} · {profile.tagline}
    </p>
    <p class="mt-5 text-base text-ink-subtle max-w-xl mx-auto leading-relaxed">
      {profile.intro}
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#work"
        class="inline-flex items-center rounded-full bg-accent text-white font-semibold text-sm px-6 py-3 hover:bg-accent-hover transition-colors"
      >
        View Work
      </a>
      <a
        href={profile.resumeUrl}
        class="inline-flex items-center rounded-full border border-border text-ink font-semibold text-sm px-6 py-3 hover:border-accent hover:text-accent-soft transition-colors"
      >
        Download Résumé
      </a>
    </div>
  </div>

  <a
    href="#story"
    aria-label="Scroll to my story"
    class="absolute bottom-4 left-1/2 -translate-x-1/2 inline-flex items-center justify-center w-11 h-11 text-ink-faint hover:text-ink transition-colors"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="animate-bounce scroll-cue"
    >
      <path d="M12 5v14M19 12l-7 7-7-7"></path>
    </svg>
  </a>
</section>
