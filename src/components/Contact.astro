---
import { profile } from "../data/site";

const year = new Date().getFullYear();
---

<section id="contact" class="relative overflow-hidden">
  <div class="glow-flank absolute inset-0 pointer-events-none"></div>
  <div class="relative max-w-3xl mx-auto px-6 py-28 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink">
      Let's talk
    </h2>
    <p class="mt-4 text-ink-subtle max-w-lg mx-auto leading-relaxed">
      I'm looking for AI Engineer roles from March 2027, and I'm happy to talk
      before then — about agentic systems, retrieval, or how to tell whether a
      GenAI feature is worth building.
    </p>

    <div class="mt-8 flex items-center justify-center gap-4">
      <a
        href={profile.links.email}
        class="rounded-full bg-accent text-white font-semibold text-sm px-6 py-3 hover:bg-accent-hover transition-colors"
      >
        Email me
      </a>
      <a
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-border text-ink font-semibold text-sm px-6 py-3 hover:border-accent hover:text-accent-soft transition-colors"
      >
        LinkedIn
      </a>
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-border text-ink font-semibold text-sm px-6 py-3 hover:border-accent hover:text-accent-soft transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>

  <footer class="border-t border-border">
    <div
      class="max-w-5xl mx-auto px-6 py-6 text-center text-sm text-ink-subtle"
    >
      © {year} {profile.name}. Built with Astro.
    </div>
  </footer>
</section>
