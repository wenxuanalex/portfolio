---
import Section from "./Section.astro";
import { skills } from "../data/site";
---

<Section id="skills" title="The toolkit behind the work">
  <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
    {
      skills.map((group) => (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-[0.15em] text-accent-soft pb-3 border-b border-border">
            {group.category}
          </h3>
          <ul class="mt-4 space-y-2.5 list-none m-0 p-0">
            {group.items.map((item) => (
              <li class="text-ink text-sm font-medium">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
