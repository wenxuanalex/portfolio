---
import Section from "./Section.astro";
import { education } from "../data/site";
---

<Section id="education" eyebrow="Background" title="Education">
  <div class="space-y-4">
    {
      education.map((edu) => (
        <div class="rounded-2xl border border-border bg-canvas-raised p-6 sm:flex sm:items-start sm:gap-6">
          <div class="font-mono text-sm font-medium text-accent-soft sm:w-40 shrink-0 mb-2 sm:mb-0">
            {edu.period}
          </div>
          <div>
            <h3 class="text-ink font-semibold">{edu.degree}</h3>
            <p class="text-ink-subtle text-sm mt-0.5">{edu.school}</p>
            <p class="text-ink-faint text-sm mt-3 leading-relaxed">
              {edu.detail}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
